      "difficulty": "medium",
      "expected": {
        "space_count": 6,
        "note": "LLM должен сам выбрать размер, т.к. не указан"
      }
    },
    {
      "id": "bench_014",
      "prompt": "Создай офисный блок: коридор, 3 кабинета по 4х5 и 1 переговорная 6х8",
      "category": "corridor_layout",
      "difficulty": "hard",
      "expected": {
        "space_count": 5,
        "layout_strategy": "corridor_with_rooms_one_side",
