      }
    },
    {
      "id": "bench_006",
      "prompt": "Создай 3 кабинета и коридор шириной 2 метра",
      "category": "corridor_layout",
      "difficulty": "medium",
      "expected": {
        "space_count": 4,
        "layout_strategy": "corridor_with_rooms_one_side",
        "has_corridor": true
      }
    },
    {
      "id": "bench_007",
      "prompt": "Создай кухню 3 на 4 метра и санузел 2 на 2 метра",
      "category": "multiple_rooms",
      "difficulty": "medium",
      "expected": {
        "space_count": 2,
        "layout_strategy": "row_of_rooms",
        "expected_kinds": ["kitchen", "wc"]
      }
    },
    {
      "id": "bench_008",
      "prompt": "Создай 5 одинаковых кабинетов 4 на 5 метров",
      "category": "multiple_rooms",
      "difficulty": "medium",
      "expected": {
        "space_count": 5,
        "layout_strategy": "row_of_rooms"
      }
    },
    {
      "id": "bench_009",
      "prompt": "Создай 4 кабинета и коридор шириной 1.5 метра",
      "category": "corridor_layout",
      "difficulty": "medium",
      "expected": {
        "space_count": 5,
        "layout_strategy": "corridor_with_rooms_one_side",
        "has_corridor": true
      }
    },
    {
      "id": "bench_010",
      "prompt": "Создай кладовую 2 на 2 метра",
      "category": "single_room",
      "difficulty": "easy",
      "expected": {
        "space_count": 1,
        "expected_kind": "storage"
      }
    },
    {
      "id": "bench_011",
      "prompt": "Создай переговорную 6х8 и 2 кабинета рядом по 4х5",
      "category": "multiple_rooms",
      "difficulty": "medium",
      "expected": {
        "space_count": 3,
