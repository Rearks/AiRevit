        "expected_kinds": ["corridor", "office", "office", "office", "meeting"]
      }
    },
    {
      "id": "bench_015",
      "prompt": "Создай санузел 2 на 3 метра и кладовую 2 на 2 рядом",
      "category": "multiple_rooms",
      "difficulty": "medium",
      "expected": {
        "space_count": 2,
        "expected_kinds": ["wc", "storage"]
      }
    },
    {
      "id": "bench_016",
      "prompt": "Создай комнату высотой 4 метра, размером 5 на 6 метров",
      "category": "single_room",
      "difficulty": "easy",
      "expected": {
        "space_count": 1,
        "expected_height_mm": 4000
      }
    },
    {
      "id": "bench_017",
      "prompt": "Сделай 2 кабинета, кухню и коридор",
      "category": "corridor_layout",
      "difficulty": "hard",
      "expected": {
        "space_count": 4,
        "has_corridor": true,
        "expected_kinds": ["office", "office", "kitchen", "corridor"],
        "note": "LLM должен сам определить размеры"
      }
    },
    {
      "id": "bench_018",
      "prompt": "Создай помещение 10 на 12 метров",
      "category": "single_room",
      "difficulty": "easy",
      "expected": {
        "space_count": 1,
        "layout_strategy": "single_room",
        "expected_kind": "room"
      }
    },
    {
      "id": "bench_019",
      "prompt": "Сделай коридор шириной 1800 мм и 5 кабинетов по 3500 на 4000 мм",
      "category": "corridor_layout",
      "difficulty": "hard",
      "expected": {
        "space_count": 6,
        "layout_strategy": "corridor_with_rooms_one_side",
        "has_corridor": true
      }
    },
    {
      "id": "bench_020",
      "prompt": "Создай 2 санузла по 2 на 2.5 метра",
      "category": "multiple_rooms",
      "difficulty": "medium",
      "expected": {
        "space_count": 2,
        "expected_kinds": ["wc", "wc"]
