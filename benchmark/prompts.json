{
  "version": "1.0",
  "description": "Benchmark набор типовых промптов для регрессионного тестирования AiRevit pipeline",
  "prompts": [
    {
      "id": "bench_001",
      "prompt": "Создай кабинет 4 на 5 метров",
      "category": "single_room",
      "difficulty": "easy",
      "expected": {
        "space_count": 1,
        "layout_strategy": "single_room",
        "min_walls": 4,
        "min_floors": 1,
        "min_rooms": 1
      }
    },
    {
      "id": "bench_002",
      "prompt": "Создай стену длиной 1000 мм",
      "category": "single_wall",
      "difficulty": "easy",
      "expected": {
        "space_count": 0,
        "min_walls": 1
      },
      "note": "Прямой режим create_wall, без semantic intent"
    },
    {
      "id": "bench_003",
      "prompt": "Создай квадратную комнату 3 на 3 метра",
      "category": "single_room",
      "difficulty": "easy",
      "expected": {
        "space_count": 1,
        "layout_strategy": "single_room",
        "min_walls": 4
      }
    },
    {
      "id": "bench_004",
      "prompt": "Создай 3 кабинета по 4 на 5 метров",
      "category": "multiple_rooms",
      "difficulty": "medium",
      "expected": {
        "space_count": 3,
        "layout_strategy": "row_of_rooms",
        "min_walls": 8,
        "min_rooms": 3
      }
    },
    {
      "id": "bench_005",
      "prompt": "Создай переговорную 6 на 8 метров",
      "category": "single_room",
      "difficulty": "easy",
      "expected": {
        "space_count": 1,
        "layout_strategy": "single_room",
